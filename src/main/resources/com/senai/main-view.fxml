<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="405.0" prefWidth="703.0" spacing="20.0" stylesheets="@../../style/main.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senai.controller.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="label" />

    <Button onAction="#onBtnClick" prefHeight="25.0" prefWidth="251.0" style="-fx-base: #107c10; -fx-text-fill: white;" text="Clique" textFill="WHITE" />

    <VBox fx:id="containerLabels" alignment="TOP_LEFT" prefHeight="265.0" prefWidth="663.0" spacing="5.0" style="-fx-background-color: #000000; -fx-padding: 10px; -fx-border-color: #00ff00; -fx-border-width: 1px;" />
</VBox>
